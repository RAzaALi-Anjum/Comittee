# =============================================
# Digital Committee Backend — Environment Config
# =============================================

PORT=5000

# JWT Secrets (generate strong random strings)
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here

# AES-256 Encryption (must be exactly 32 bytes hex = 64 hex chars for key, 16 bytes hex = 32 hex chars for IV)
AES_SECRET_KEY=your_64_hex_char_aes_key_here
AES_IV=your_32_hex_char_iv_here

# Firebase — use either service account JSON or project config
FIREBASE_DATABASE_URL=https://com1-e2378-default-rtdb.firebaseio.com
# FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# CORS
CORS_ORIGIN=http://localhost:19006
